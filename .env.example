# ====================================================
# .env.example — Copy file này thành .env và điền giá trị thật
# KHÔNG COMMIT file .env thật lên GitHub!
# ====================================================

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=quanlysanbong

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME="He Thong Dat San Bong"

# Email thông báo cho Admin khi có đơn mới (tuỳ chọn)
MAIL_ADMIN_NOTIFY=admin@example.com

# VNPay (nếu dùng, để trống nếu không dùng)
VNPAY_TMNCODE=YOUR_TMNCODE
VNPAY_HASHSECRET=YOUR_HASHSECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost/quanlysanbong/index.php?controller=Payment&action=vnpay_return

# Thông tin tài khoản nhận thanh toán VietQR
VIETQR_BANK_ID=MB
VIETQR_BANK_NAME="MB Bank (Ngân hàng Quân Đội)"
VIETQR_ACCOUNT_NO=1111000050174
VIETQR_ACCOUNT_NAME="HOANG VAN HUY"
