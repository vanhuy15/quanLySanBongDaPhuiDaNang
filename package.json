{
  "name": "quanlysanbong",
  "version": "1.0.0",
  "description": "Hệ thống đặt sân bóng mini trực tuyến toàn diện bằng PHP MVC và MySQL",
  "main": "assets/js/main.js",
  "scripts": {
    "start": "node scripts/start-server.js",
    "stop": "node scripts/stop-server.js",
    "test:unit": "node scripts/run-php.js tester/01_unit_test/phpunit.phar --do-not-cache-result tester/01_unit_test",
    "test:api": "npx --yes newman run tester/02_api_test/QuanLySanBong_API.postman_collection.json -e tester/02_api_test/QuanLySanBong.postman_environment.json",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:report": "npx playwright show-report tester/03_e2e_ui_test/playwright-report",
    "test:security": "node scripts/run-php.js tester/05_security_test/security_audit_runner.php",
    "test:all": "npm run test:unit && npm run test:api && npm run test:security && npm run test:e2e",
    "db:migrate": "node scripts/run-php.js database/migrate.php",
    "db:seed": "node scripts/run-php.js database/seed.php",
    "db:backup": "node scripts/run-php.js database/backup.php",
    "slots:cleanup": "node scripts/run-php.js scripts/cron_cleanup_slots.php"
  },
  "keywords": [
    "php",
    "mysql",
    "testing",
    "phpunit",
    "playwright",
    "jmeter",
    "owasp-zap"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
