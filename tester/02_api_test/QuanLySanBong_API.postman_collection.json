      "name": "01 - Authentication & Security",
      "item": [
        {
          "name": "TC00 - Khởi tạo phiên & Trích xuất CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 200\", function () { pm.response.to.have.status(200); });",
                  "const html = pm.response.text();",
                  "const match = html.match(/name=\"csrf_token\"\\s+value=\"([a-f0-9]{64})\"/);",
                  "if (match) { pm.environment.set(\"csrf_token\", match[1]); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/index.php?controller=Auth&action=login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "index.php"
              ],
              "query": [
                {
                  "key": "controller",
                  "value": "Auth"
                },
                {
                  "key": "action",
                  "value": "login"
                }
              ]
            }
          }
        },
