<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan - Quan Ly San Bong Compound Pitch Conflict">
      <stringProp name="TestPlan.comments">Kiểm thử đồng thời xung đột Sân 7 ghép và Sân con lẻ (Compound Pitch Concurrency Conflict)</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">80</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SAN_ID" elementType="Argument">
            <stringProp name="Argument.name">SAN_ID</stringProp>
            <stringProp name="Argument.value">2</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="KHUNG_GIO_ID" elementType="Argument">
            <stringProp name="Argument.name">KHUNG_GIO_ID</stringProp>
            <stringProp name="Argument.value">3</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NGAY_DAT" elementType="Argument">
            <stringProp name="Argument.name">NGAY_DAT</stringProp>
            <stringProp name="Argument.value">2026-12-15</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <!-- Group 1: 20 Users tranh đặt Sân 7 (Khóa cụm A,B) -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Group 1: 20 Users Dat San 7 (Khoa A+B)">
        <intProp name="ThreadGroup.num_threads">20</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST - Dat San 7 (A,B)">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.path">/quanlysanbong/index.php?controller=DatSan&amp;action=processBooking</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments">
              <elementProp name="san_id" elementType="HTTPArgument">
                <stringProp name="Argument.name">san_id</stringProp>
                <stringProp name="Argument.value">${SAN_ID}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="khung_gio_id" elementType="HTTPArgument">
                <stringProp name="Argument.name">khung_gio_id</stringProp>
                <stringProp name="Argument.value">${KHUNG_GIO_ID}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ngay_dat" elementType="HTTPArgument">
                <stringProp name="Argument.name">ngay_dat</stringProp>
                <stringProp name="Argument.value">${NGAY_DAT}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ten_san_con" elementType="HTTPArgument">
                <stringProp name="Argument.name">ten_san_con</stringProp>
                <stringProp name="Argument.value">Sân 7 (A+B)</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="san_con_khoa" elementType="HTTPArgument">
                <stringProp name="Argument.name">san_con_khoa</stringProp>
                <stringProp name="Argument.value">A,B</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

      <!-- Group 2: 20 Users tranh đặt Sân con lẻ A -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Group 2: 20 Users Dat San Con A">
        <intProp name="ThreadGroup.num_threads">20</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST - Dat San Con A">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.path">/quanlysanbong/index.php?controller=DatSan&amp;action=processBooking</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments">
              <elementProp name="san_id" elementType="HTTPArgument">
                <stringProp name="Argument.name">san_id</stringProp>
                <stringProp name="Argument.value">${SAN_ID}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="khung_gio_id" elementType="HTTPArgument">
                <stringProp name="Argument.name">khung_gio_id</stringProp>
                <stringProp name="Argument.value">${KHUNG_GIO_ID}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ngay_dat" elementType="HTTPArgument">
                <stringProp name="Argument.name">ngay_dat</stringProp>
                <stringProp name="Argument.value">${NGAY_DAT}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="ten_san_con" elementType="HTTPArgument">
                <stringProp name="Argument.name">ten_san_con</stringProp>
                <stringProp name="Argument.value">Sân con A</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>

